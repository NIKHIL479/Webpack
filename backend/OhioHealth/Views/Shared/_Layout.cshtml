@using System.IO
@using Newtonsoft.Json //download Newtonsoft.Json via NuGet
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment

@inject IConfiguration Configuration
@{
    var assetsBundleFile = System.IO.Path.Combine(Environment.WebRootPath, "build/assets.json");
    string? mainJS = "";
    string? vendorJS = "";
    string? runtimeJS = "";
    string? mainCSS = "";
    if (File.Exists(assetsBundleFile))
    {
        var bundleNamesJson = File.ReadAllText(assetsBundleFile);
        dynamic bundleAssetHelpers = JsonConvert.DeserializeObject(bundleNamesJson);
        mainJS = bundleAssetHelpers?["main.js"];
        mainCSS = bundleAssetHelpers?["main.css"];
        vendorJS = bundleAssetHelpers?["vendors.js"];
        runtimeJS = bundleAssetHelpers?["runtime.js"];

    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OhioHealth</title>

    <link rel="stylesheet" href="@mainCSS" asp-append-version="true" />
       @* Render the JS bundle *@
    <script src="@mainJS" asp-append-version="true"></script>
    <script src="@vendorJS" asp-append-version="true"></script>
    <script src="@runtimeJS" asp-append-version="true"></script>
</head>
<body>
    <div class="container">
        <main role="main" class="pb-3">
            <h1>Text from layout.cshtml</h1>
            <h1>@Environment.EnvironmentName</h1>
           

            <h2>@Configuration["EnvironmentCheck"]</h2>
            @RenderBody()
        </main>
    </div>

 

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
