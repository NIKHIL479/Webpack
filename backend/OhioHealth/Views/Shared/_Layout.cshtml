@using System.IO
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OhioHealth</title>

</head>
<body>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
@{
    var assetsPath = System.IO.Path.Combine(
        Directory.GetCurrentDirectory(),
        "wwwroot",
        "build",
        "assets.json"
    );

    var assets = System.IO.File.Exists(assetsPath)
        ? System.Text.Json.JsonDocument.Parse(System.IO.File.ReadAllText(assetsPath))
        : null;

    var bundleJs = assets?.RootElement
        .GetProperty("main")
        .GetProperty("js")
        .GetString() ?? "/build/bundle.js";
}

            <script src="@bundleJs"></script>
        </main>
    </div>

   
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
