@using System.IO
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment

@{
    var assetsBundleFile=System.IO.Path.Combine(Environment.WebRootPath,"build/assets.json");
    if(File.Exists(assetsBundleFile))
    {
      
    }
}



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OhioHealth</title>
</head>



<body>
    <div class="container">
        <main role="main" class="pb-3">
            <h1>text from layout.cshtml</h1>
            @RenderBody()
        </main>
    </div>

    @{
        var assetsPath = System.IO.Path.Combine(
            Directory.GetCurrentDirectory(),
            "wwwroot",
            "build",
            "assets.json" 
        );

        string bundleJs = "/build/bundle.js";

        if (System.IO.File.Exists(assetsPath))
        {
            var assets = System.Text.Json.JsonDocument.Parse(
                System.IO.File.ReadAllText(assetsPath)
            );

            bundleJs = assets.RootElement 
                .GetProperty("index")
                .GetProperty("js")
                .GetString();
        }
    }

    <script src="@bundleJs"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
